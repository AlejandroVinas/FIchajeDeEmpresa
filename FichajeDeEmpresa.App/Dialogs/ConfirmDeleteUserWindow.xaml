<Window x:Class="FichajeDeEmpresa.App.Dialogs.ConfirmDeleteUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Borrado definitivo"
        Width="560"
        SizeToContent="Height"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="18">
        <Border Style="{StaticResource AppCardBorderStyle}"
                Padding="20">
            <StackPanel>
                <TextBlock Text="Borrado definitivo"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource DangerBrush}" />

                <Border Margin="0,16,0,0"
                        Background="{StaticResource DangerBackgroundBrush}"
                        BorderBrush="{StaticResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"
                               Text="Vas a eliminar definitivamente este usuario y todos sus fichajes. Esta acción no se puede deshacer." />
                </Border>

                <TextBlock x:Name="UserInfoTextBlock"
                           Margin="0,18,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <TextBlock Margin="0,16,0,6"
                           Text="Escribe BORRAR para confirmar"
                           Style="{StaticResource AppFieldLabelStyle}" />

                <TextBox x:Name="DeleteKeywordTextBox"
                         Style="{StaticResource AppTextBoxStyle}" />

                <Border x:Name="MessageBorder"
                        Margin="0,16,0,0"
                        Background="{StaticResource DangerBackgroundBrush}"
                        BorderBrush="{StaticResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="MessageTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="2"
                            Width="120"
                            Content="Cancelar"
                            Style="{StaticResource AppSecondaryButtonStyle}"
                            Click="CancelButton_Click" />

                    <Button Grid.Column="4"
                            Width="130"
                            Content="Borrar"
                            Style="{StaticResource AppDangerButtonStyle}"
                            Click="ConfirmButton_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>