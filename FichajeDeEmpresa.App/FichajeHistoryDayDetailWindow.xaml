<Window x:Class="FichajeDeEmpresa.App.FichajeHistoryDayDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle del día"
        Icon="pack://application:,,,/Assets/Icons/app-icon.ico"
        Width="760"
        Height="760"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}">
       

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0"
                Style="{StaticResource AppCardBorderStyle}">
            <StackPanel>
                <TextBlock x:Name="TitleTextBlock"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <TextBlock x:Name="SubtitleTextBlock"
                           Margin="0,10,0,0"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Resumen -->
        <WrapPanel Grid.Row="2"
                   ItemWidth="170"
                   Orientation="Horizontal">
            <Border Style="{StaticResource AppSoftCardBorderStyle}"
                    Width="170"
                    Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Estado"
                               Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBlock x:Name="StatusValueTextBlock"
                               Margin="0,10,0,0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppSoftCardBorderStyle}"
                    Width="170"
                    Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Trabajado"
                               Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBlock x:Name="WorkedValueTextBlock"
                               Margin="0,10,0,0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppSoftCardBorderStyle}"
                    Width="170"
                    Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Normales"
                               Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBlock x:Name="NormalValueTextBlock"
                               Margin="0,10,0,0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppSoftCardBorderStyle}"
                    Width="170"
                    Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Extra"
                               Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBlock x:Name="ExtraValueTextBlock"
                               Margin="0,10,0,0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Movimientos -->
        <Border Grid.Row="4"
                Style="{StaticResource AppCardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Movimientos"
                           Style="{StaticResource AppSectionTitleStyle}" />

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MovementsPanel" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>